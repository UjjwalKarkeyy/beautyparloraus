# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env
# ─────────────────────────────────────────────

# Server port (default: 3000)
PORT=3000

# Admin dashboard password — change this to something secret
ADMIN_KEY=change-this-to-a-strong-secret

# ── Email (Nodemailer) ────────────────────────
# Gmail example: use an App Password (not your normal Gmail password)
# Guide: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# The salon's inbox that receives new order notifications
SALON_EMAIL=salon@browbeautyhub.com.au
